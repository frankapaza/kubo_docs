<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net48</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <RootNamespace>Kubo.Log4Net.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.*" />
    <PackageReference Include="xunit" Version="2.9.*" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.*" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <!-- Una referencia por TFM de prueba para que cada ejecución ejercite una variante real del
       appender con su versión de log4net: net48 prueba net45 (log4net 2.0.8) y net10.0 prueba
       netstandard2.0 (log4net 3.2.0).
       La restauración de NuGet ignora SetTargetFramework y elegiría net462 (log4net 3.2.0), lo que
       choca con el log4net 2.0.8 de net48 (NU1605). Por eso en net48 el ProjectReference solo
       compila la variante net45 (ReferenceOutputAssembly=false) y la DLL se referencia a mano. -->
  <ItemGroup Condition="'$(TargetFramework)'=='net48'">
    <ProjectReference Include="..\..\src\Kubo.Log4Net\Kubo.Log4Net.csproj" SetTargetFramework="TargetFramework=net45" ReferenceOutputAssembly="false" />
    <Reference Include="Kubo.Log4Net">
      <HintPath>..\..\src\Kubo.Log4Net\bin\$(Configuration)\net45\Kubo.Log4Net.dll</HintPath>
    </Reference>
    <PackageReference Include="log4net" Version="2.0.8" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)'=='net10.0'">
    <ProjectReference Include="..\..\src\Kubo.Log4Net\Kubo.Log4Net.csproj" SetTargetFramework="TargetFramework=netstandard2.0" />
    <PackageReference Include="log4net" Version="3.2.0" />
  </ItemGroup>

</Project>
