# Copia este archivo a .env.production en el VPS y completa los valores.
# Genera los secretos con: openssl rand -base64 48

# MySQL
DB_ROOT_PASSWORD=cambiar-password-muy-fuerte
DB_NAME=kubo_devdocs

# JWT + AES
JWT_ACCESS_SECRET=cambiar-con-openssl-rand-base64-48
JWT_REFRESH_SECRET=cambiar-con-openssl-rand-base64-48
CRYPTO_SECRET=cambiar-con-openssl-rand-base64-48

# JWT del portal de clientes. DEBEN ser distintos de los del personal:
# ahi esta la frontera criptografica entre el equipo interno y los clientes.
JWT_CLIENT_ACCESS_SECRET=cambiar-por-un-secreto-distinto-al-del-personal
JWT_CLIENT_REFRESH_SECRET=cambiar-por-otro-secreto-distinto

# Transcripcion (Groq/OpenAI)
OPENAI_API_KEY=gsk_TU_API_KEY_DE_GROQ
WHISPER_API_BASE_URL=https://api.groq.com/openai/v1
WHISPER_MODEL=whisper-large-v3-turbo
WHISPER_LANGUAGE=es

# CORS (dominio publico)
CORS_ORIGINS=https://docs.kuboti.com

# URL publica del frontend. Base de los enlaces que van dentro de los correos
# (ticket en el portal, ticket en el panel, firma de documentos). Sin barra
# final, y con el dominio real.
#
# Si se deja en blanco o se borra la linea, docker-compose la inyecta como
# cadena vacia —no omite la clave— y el backend cae al valor por defecto
# (http://localhost:5173). Los enlaces de los correos saldran apuntando a
# localhost: se entienden y se pueden corregir a mano, pero no abren nada desde
# fuera del servidor.
FRONTEND_URL=https://docs.kuboti.com

# SMTP — respaldo del .env
#
# La fuente buena es la base: Ajustes del area de trabajo -> Datos del emisor
# -> SMTP, que se guarda en workspace_settings y GANA a estas variables. Estas
# son para que el correo salga desde el primer arranque, antes de que nadie
# entre al panel, y para que siga saliendo si alguien vacia esos campos.
#
# No es opcional de la misma forma que antes. Los avisos de tickets los manda
# un vigilante que drena la cola cada minuto: sin ninguna de las dos fuentes,
# cada aviso falla, agota sus tres intentos en veinticinco minutos y queda
# abandonado —sellado, con el error grabado y sin reintento—. Es decir, los
# avisos de esos primeros minutos no se recuperan solos cuando por fin se
# configure el SMTP; hay que rehacerlos a mano.
#
# Se pueden dejar en blanco si se va a configurar por panel antes de que entre
# el primer ticket: en blanco cuentan como no configuradas, no como una
# configuracion rota.
#
# Y por eso van en blanco aqui. Repartirlas rellenas con la contrasena en
# placeholder seria peor que dejarlas vacias: quien copie el fichero sin
# editarlo se lleva "configurado pero con la clave mal", que quema la cola
# exactamente igual y con peor diagnostico —el error no dice "falta
# configurar", dice que el servidor rechazo la autenticacion—. Vacias, el
# fallo es explicito desde el primer intento.
#
# Los valores del buzon de la mesa de servicio estan en SECRETS.local.txt.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# Si se deja vacio se usa SMTP_USER. Muchos proveedores exigen que el From
# coincida con el usuario autenticado, y EmailService lo reescribe si no.
SMTP_FROM=

# Web build (URL que usara el frontend para llamar a la API)
VITE_API_BASE_URL=https://docs.kuboti.com/api/v1
