NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Numero de proxies de confianza por delante del backend. La limitacion de
# intentos del portal cuenta por IP de cliente, y detras de un proxy esa IP
# solo se conoce por X-Forwarded-For. En desarrollo el backend se expone
# directo: 0. Con el Caddy de docker-compose.yml delante: 1.
TRUST_PROXY_HOPS=0

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=kubo_devdocs

# JWT
JWT_ACCESS_SECRET=change-me-access
# Ceiling del JWT. El cierre real por inactividad lo controla el frontend
# con sessionTimeoutMinutes configurable en workspace_settings.
JWT_ACCESS_EXPIRES_IN=12h
JWT_REFRESH_SECRET=change-me-refresh
JWT_REFRESH_EXPIRES_IN=7d

# JWT del portal de clientes. DEBEN ser distintos de los del personal:
# ahi esta la frontera criptografica entre el equipo interno y los clientes.
JWT_CLIENT_ACCESS_SECRET=cambiar-por-un-secreto-distinto-al-del-personal
JWT_CLIENT_REFRESH_SECRET=cambiar-por-otro-secreto-distinto

# Redis / BullMQ
REDIS_HOST=localhost
REDIS_PORT=6379

# Storage
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads
AUDIO_MAX_SIZE_MB=100

# Whisper / transcripción
TRANSCRIPTION_PROVIDER=whisper-api
OPENAI_API_KEY=sk-REPLACE_ME

# CORS
CORS_ORIGINS=http://localhost:5173

# URL publica del frontend. Es la base de los enlaces que se meten dentro de
# los correos: el del ticket en el portal, el del ticket en el panel y el de
# firma de documentos. Sin barra final. En produccion, el dominio real: si se
# queda en localhost, los avisos llegan con enlaces que no abren nada.
FRONTEND_URL=http://localhost:5173

# SMTP (envío de correo con documentos adjuntos)
# Ejemplos:
#   Gmail:     SMTP_HOST=smtp.gmail.com   SMTP_PORT=587  SMTP_SECURE=false (usa app password)
#   Office365: SMTP_HOST=smtp.office365.com SMTP_PORT=587 SMTP_SECURE=false
#   SendGrid:  SMTP_HOST=smtp.sendgrid.net SMTP_PORT=587 SMTP_USER=apikey SMTP_PASS=<API_KEY>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Kubo DevDocs <no-reply@kuboti.com>"
