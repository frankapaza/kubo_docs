{
  "name": "@kubo/monitor-widget",
  "version": "0.1.0",
  "private": true,
  "description": "Widget de escritorio de KUBO Monitor (Electron + React).",
  "main": "out/main/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.main.json && vite build",
    "test": "jest",
    "dev": "npm run build && electron .",
    "pack": "npm run build && electron-builder --win --dir",
    "dist": "npm run build && electron-builder --win"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "jest": "^29.7.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.0",
    "ts-jest": "^29.4.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.8"
  },
  "productName": "KUBO Monitor",
  "author": "KUBO"
}
